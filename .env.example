CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'

# MySQL 8.0.16+ atau MariaDB 10.6+. Buat database terlebih dahulu.
database.default.hostname = 127.0.0.1
database.default.database = parkir
database.default.username = parkir_app
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.port = 3306

# Isi password unik 12 sampai 72 karakter sebelum menjalankan InitialSeeder.
# Hapus parkir.adminPassword dari .env setelah seed berhasil.
parkir.adminUsername = admin
parkir.adminPassword = ''

# Database terpisah. Tes menghapus data di database ini.
database.tests.hostname = 127.0.0.1
database.tests.database = parkir_test
database.tests.username = parkir_test
database.tests.password = ''
database.tests.DBDriver = MySQLi
database.tests.port = 3306

# Aktifkan dua pengaturan berikut untuk server produksi HTTPS.
# CI_ENVIRONMENT = production
# app.forceGlobalSecureRequests = true
# Cookie.secure = true
Cookie.httponly = true
Cookie.samesite = Lax
